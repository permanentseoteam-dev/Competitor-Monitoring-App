<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dashboard · Competitor Monitor</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="app-shell">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <aside class="sidebar">
      <div class="brand" aria-label="Competitor Monitor">
        <span class="brand-orbit" aria-hidden>
          <span class="brand-core">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <path d="M4 7h16v11H4V7Zm3-3h10l1.5 3h-13L7 4Z" fill="currentColor" />
            </svg>
          </span>
        </span>
        <span class="brand-copy">
          <strong>Monitor</strong>
          <span>Competitor intel</span>
        </span>
      </div>

      <button type="button" class="workspace-switch">
        <span class="workspace-left">
          <span class="workspace-dot" aria-hidden></span>
          Monitor&apos;s
        </span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden>
          <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>

      <ul class="nav-list" id="nav-list">
        <li><button type="button" class="nav-item active" data-nav="dashboard">Dashboard</button></li>
        <li><button type="button" class="nav-item" data-nav="competitors">Competitors</button></li>
        <li><button type="button" class="nav-item" data-nav="products">New Products</button></li>
        <li><button type="button" class="nav-item" data-nav="runs">Scrape Runs</button></li>
        <li><button type="button" class="nav-item" data-nav="settings">Settings</button></li>
      </ul>

      <div class="sidebar-footer">
        <div class="profile-row">
          <div class="profile-identity">
            <span class="avatar" aria-hidden>CM</span>
            <span class="profile-copy">
              <strong>CM Admin</strong>
              <span>Signed in</span>
            </span>
          </div>
          <form action="/logout" method="post">
            <button type="submit" class="logout-icon-btn" aria-label="Sign out" title="Sign out">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden>
                <path d="M10 7V6a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <path d="M15 12H3m0 0 3-3m-3 3 3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <main id="main-content" class="main-pane">
      <div class="page-header">
        <div>
          <h1 id="page-title">Dashboard</h1>
          <p id="page-subtitle">Welcome back! Here's your competitor monitoring overview.</p>
        </div>
        <button type="button" class="btn primary" id="btn-new-competitor">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden>
            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          New Competitor
        </button>
      </div>

      <div id="pricing-banner-root"></div>
      <p id="global-error" class="error" hidden></p>
      <div id="view-root" aria-busy="true"></div>
    </main>
  </div>

  <script>
    window.__CM__ = {
      pricingBanner: <%- JSON.stringify(pricingBanner) %>,
      intervalOptions: <%- JSON.stringify(intervalOptions) %>
    };
  </script>
  <script src="/dashboard.js" defer></script>
</body>
</html>
