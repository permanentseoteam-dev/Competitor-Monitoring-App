# Local: uses data/store.json automatically (no storage env required)

# Required login credentials (set locally and on Vercel)
AUTH_USERNAME=
AUTH_PASSWORD=
# openssl rand -base64 32
SESSION_SECRET=

# Vercel: set ONE of these storage options
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# BLOB_READ_WRITE_TOKEN=

# Optional cron auth
# CRON_SECRET=
